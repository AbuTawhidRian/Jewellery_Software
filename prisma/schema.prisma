generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  companies    Company[]
  subscription Subscription?
  users        User[]
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               SubscriptionStatus @default(TRIAL)
  plan                 String             @default("FREE")
  maxUsers             Int                @default(2)
  maxCompanies         Int                @default(1)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(VIEWER)
  tenantId     String
  companyId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  company      Company?   @relation(fields: [companyId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Company {
  id           String       @id @default(uuid())
  name         String
  country      String
  currency     String       @default("USD")
  timezone     String       @default("UTC")
  tenantId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  currencies   Json?
  customKarats Json?
  address      String?
  email        String?
  phone        String?
  trn          String?
  accounts     Account[]
  branches     Branch[]
  cashLedger   CashLedger[]
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  customers    Customer[]
  goldLedger   GoldLedger[]
  metalRates   MetalRate[]
  users        User[]
  vendors      Vendor[]

  @@index([tenantId])
}

model MetalRate {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  gold24k   Decimal  @default(0) @db.Decimal(10, 2)
  gold22k   Decimal  @default(0) @db.Decimal(10, 2)
  gold18k   Decimal  @default(0) @db.Decimal(10, 2)
  silver    Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("USD")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Customer {
  id               String       @id @default(uuid())
  name             String
  phone            String?
  email            String?
  address          String?
  companyId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  country          String?
  trn              String?
  cashTransactions CashLedger[]
  company          Company      @relation(fields: [companyId], references: [id])
  goldTransactions GoldLedger[]

  @@index([companyId])
}

model GoldLedger {
  id                    String          @id @default(uuid())
  date                  DateTime        @default(now())
  weight                Decimal         @db.Decimal(10, 3)
  purity                Decimal         @db.Decimal(10, 6)
  notes                 String?
  companyId             String
  customerId            String?
  createdAt             DateTime        @default(now())
  type                  TransactionType
  vendorId              String?
  makingRate            Decimal?        @db.Decimal(10, 2)
  metalRate             Decimal?        @db.Decimal(10, 2)
  linkedCashTransaction CashLedger?     @relation("GoldMakingCharge")
  company               Company         @relation(fields: [companyId], references: [id])
  customer              Customer?       @relation(fields: [customerId], references: [id])
  vendor                Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([vendorId])
}

model CashLedger {
  id                String          @id @default(uuid())
  date              DateTime        @default(now())
  amount            Decimal         @db.Decimal(12, 2)
  currency          String
  notes             String?
  companyId         String
  customerId        String?
  createdAt         DateTime        @default(now())
  accountId         String?
  type              TransactionType
  vendorId          String?
  goldTransactionId String?         @unique
  account           Account?        @relation(fields: [accountId], references: [id])
  company           Company         @relation(fields: [companyId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id])
  goldTransaction   GoldLedger?     @relation("GoldMakingCharge", fields: [goldTransactionId], references: [id])
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([vendorId])
}

model Vendor {
  id               String       @id @default(uuid())
  name             String
  phone            String?
  email            String?
  address          String?
  trn              String?
  country          String?
  companyId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  cashTransactions CashLedger[]
  goldTransactions GoldLedger[]
  company          Company      @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Account {
  id           String       @id @default(uuid())
  name         String
  type         AccountType  @default(EXPENSE)
  companyId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company      @relation(fields: [companyId], references: [id])
  transactions CashLedger[]

  @@index([companyId])
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  ACCOUNTANT
  PRODUCTION_STAFF
  VIEWER
  OWNER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  PAST_DUE
  CANCELED
}

enum TransactionType {
  METAL_PURCHASE
  METAL_SALE
  METAL_RECEIPT
  METAL_PAYMENT
  METAL_RECEIPT_RETURN
  METAL_PAYMENT_RETURN
  CASH_RECEIPT
  CASH_PAYMENT
  MAKING_CHARGE
  ADJUSTMENT
}

enum AccountType {
  INCOME
  EXPENSE
}
