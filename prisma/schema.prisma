generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  ACCOUNTANT
  PRODUCTION_STAFF
  VIEWER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  PAST_DUE
  CANCELED
}

enum GoldTransactionType {
  RECEIVE_GOLD      // Customer gives gold
  USE_FOR_JEWELLERY // Gold used in manufacturing
  JEWELLERY_DELIVERY // Gold delivered as product
  JEWELLERY_RETURN  // Product returned
  ADJUSTMENT        // Wastage / Correction
}

enum CashTransactionType {
  RECEIVE_PAYMENT
  PAY_CUSTOMER
  EXPENSE
  OTHER
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELIVERED
  RETURNED
  CANCELLED
}

// -----------------------------------------------------------------------------
// TENANCY & AUTH
// -----------------------------------------------------------------------------

model Tenant {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  subscription Subscription?
  companies    Company[]
  users        User[]
  auditLogs    AuditLog[]
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               SubscriptionStatus @default(TRIAL)
  plan                 String             @default("FREE")
  
  maxUsers             Int                @default(2)
  maxCompanies         Int                @default(1)
  
  currentPeriodEnd     DateTime?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole  @default(VIEWER)
  
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  // Optional: Restrict user to specific company (if null, access depends on role/logic)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])

  auditLogs    AuditLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// ORGANIZATION STRUCTURE
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  country   String
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  branches        Branch[]
  users           User[]
  customers       Customer[]
  goldLedger      GoldLedger[]
  cashLedger      CashLedger[]
  jewelleryOrders JewelleryOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// -----------------------------------------------------------------------------
// CORE BUSINESS ENTITIES
// -----------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  
  orders    JewelleryOrder[]
  goldTransactions GoldLedger[]
  cashTransactions CashLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model JewelleryOrder {
  id          String      @id @default(uuid())
  orderNo     String      // Friendly ID like ORD-001
  status      OrderStatus @default(PENDING)
  
  description String?
  imageUrl    String?     // For design image
  
  // Estimates
  estimatedWeight Decimal? @db.Decimal(10, 3)
  
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])

  goldLedgerEntries GoldLedger[]
  cashLedgerEntries CashLedger[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId])
  @@index([customerId])
}

// -----------------------------------------------------------------------------
// LEDGERS (APPEND ONLY)
// -----------------------------------------------------------------------------

model GoldLedger {
  id          String              @id @default(uuid())
  date        DateTime            @default(now())
  
  type        GoldTransactionType
  weight      Decimal             @db.Decimal(10, 3) // Grams
  purity      Decimal             @db.Decimal(5, 2)  // e.g. 99.99, 91.60
  
  notes       String?
  
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])

  // Context
  orderId     String?
  order       JewelleryOrder?     @relation(fields: [orderId], references: [id])

  customerId  String?
  customer    Customer?           @relation(fields: [customerId], references: [id])

  createdAt   DateTime            @default(now())
  // No updatedAt - Append Only

  @@index([companyId])
  @@index([customerId])
  @@index([orderId])
}

model CashLedger {
  id          String              @id @default(uuid())
  date        DateTime            @default(now())
  
  type        CashTransactionType
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              // ISO code e.g. USD
  
  notes       String?
  
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])

  // Context
  orderId     String?
  order       JewelleryOrder?     @relation(fields: [orderId], references: [id])

  customerId  String?
  customer    Customer?           @relation(fields: [customerId], references: [id])

  createdAt   DateTime            @default(now())
  // No updatedAt - Append Only

  @@index([companyId])
  @@index([customerId])
  @@index([orderId])
}

// -----------------------------------------------------------------------------
// SECURITY
// -----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt DateTime @default(now())

  @@index([tenantId])
}
